# Local development only. Copy to .env and change values if needed.
MYSQL_PORT=13306
MYSQL_DATABASE=burger_order
MYSQL_USER=burger_app
MYSQL_PASSWORD=burger_dev_password
MYSQL_ROOT_PASSWORD=burger_root_dev_password

# Set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false

# Redis for C1 menu cache
REDIS_PORT=16379

# D1 container deployment (profile "app")
APP_BACKEND_PORT=18080
APP_FRONTEND_PORT=18081
